# Copy to Coolify's environment variables panel for this app (do not commit real values)

# Fixed 32-char hex API keys — reuse across redeploys so init-config stays idempotent.
# Generate: openssl rand -hex 16
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# Jellyfin admin account, used once by init-config to link Jellyseerr
JELLYFIN_ADMIN_USER=
JELLYFIN_ADMIN_PASSWORD=
